---
import "../styles/app.css";
import { headerInnerRecipe, headerRecipe } from "../../../../src/recipes/header.js";
import { footerInnerRecipe, footerRecipe } from "../../../../src/recipes/footer.js";
import { linkRecipe } from "../../../../src/recipes/link.js";
import ThemeToggle from "../../../../src/svelte/ThemeToggle.svelte";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Foundation UI", description = "Tokens, shared recipes, and matching React and Svelte components. The site is built from the code it documents." } = Astro.props;

const nav = [
  { href: "/", label: "Overview" },
  { href: "/tokens", label: "Tokens" },
  { href: "/components/badge", label: "Components" },
];
const current = Astro.url.pathname;
const canonical = new URL(current, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href="/snowball-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/snowball-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="SnowballSH Foundation UI" />
    <meta property="og:image" content={new URL("/snowball-og.jpg", Astro.site)} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbfdff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a1220" />
    <script is:inline>
      (() => {
        let theme = "light";
        try {
          const stored = localStorage.getItem("fui-theme");
          theme =
            stored === "light" || stored === "dark"
              ? stored
              : matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
        } catch {}
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="min-h-svh bg-surface font-sans text-ink antialiased">
    <div
      class="pointer-events-none fixed inset-0 -z-10 bg-[radial-gradient(60rem_40rem_at_85%_-10%,color-mix(in_oklab,var(--fui-accent)_20%,transparent),transparent),radial-gradient(50rem_36rem_at_-10%_110%,color-mix(in_oklab,var(--fui-aurora)_16%,transparent),transparent),radial-gradient(38rem_26rem_at_50%_50%,color-mix(in_oklab,var(--fui-accent)_7%,transparent),transparent)]"
    >
    </div>
    <header class={headerRecipe()}>
      <div class={headerInnerRecipe()}>
        <a href="/" class="flex items-center gap-2 font-display text-sm font-semibold tracking-wide whitespace-nowrap text-ink"
          ><img src="/snowball-32.png" alt="" width="28" height="28" decoding="async" class="h-7 w-7" /> SnowballSH <span
            class="text-ink-secondary max-[420px]:hidden">Foundation UI</span
          ></a
        >
        <nav aria-label="Site" class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm sm:gap-x-5">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={current === item.href ? "page" : undefined}
                class={linkRecipe({
                  subtle: !(current === item.href),
                  className: current === item.href ? "font-medium" : undefined,
                })}
              >
                {item.label}
              </a>
            ))
          }
          <ThemeToggle client:load />
        </nav>
      </div>
    </header>
    <main class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6">
      <slot />
    </main>
    <footer class={footerRecipe()}>
      <div class={footerInnerRecipe()}>
        <div class="flex flex-wrap items-center justify-between gap-4">
          <span>© 2026 SnowballSH · Foundation UI</span>
          <a href="https://github.com/SnowballSH/foundationui" class={linkRecipe({ subtle: true })}
            >Source on GitHub</a
          >
        </div>
      </div>
    </footer>
  </body>
</html>
